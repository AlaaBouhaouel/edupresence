# Copy this file to .env for local development (never commit .env)
# All variables listed here must also be set in Railway's environment dashboard.

# ------------------------------------------------------------------
# Django core
# ------------------------------------------------------------------

# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-long-random-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of domains that Django will accept requests for.
# Include your Railway subdomain AND your custom Cloudflare domain.
# Example: myapp.up.railway.app,myapp.com,www.myapp.com
ALLOWED_HOSTS=myapp.up.railway.app,myapp.com,www.myapp.com

# Must include https:// prefix. Required for CSRF to work behind Cloudflare.
# Example: https://myapp.up.railway.app,https://myapp.com,https://www.myapp.com
CSRF_TRUSTED_ORIGINS=https://myapp.up.railway.app,https://myapp.com,https://www.myapp.com

# ------------------------------------------------------------------
# Database (Railway PostgreSQL addon sets this automatically)
# ------------------------------------------------------------------

# Railway injects this when you add the PostgreSQL addon.
# For local dev with PostgreSQL: postgresql://user:password@localhost:5432/dbname
# Leave unset locally to use SQLite fallback.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ------------------------------------------------------------------
# Firebase Realtime Database
# ------------------------------------------------------------------

# Your Firebase project's Realtime Database URL (from Firebase console)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app/

# NOTE: serviceAccountKey.json must be uploaded to Railway as a secret file
# or its contents stored as a FIREBASE_SERVICE_ACCOUNT_JSON env variable
# (requires code change — see deployment checklist).
